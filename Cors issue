const express = require('express');
const axios = require('axios');
const app = express();
 
const BASE_URL = 'https://vmi2493325.contaboserver.net';
const API_KEY = 'apikey';
const PASSWORD = 'a8aaace68a649dc60b395684b18fa4a313e838bff8e62fb77fcb28a86e2ec4c7';
const authHeader = 'Basic ' + Buffer.from(`${API_KEY}:${PASSWORD}`).toString('base64');
 
app.use((req, res) => {
  res.header('Access-Control-Allow-Origin', '*');
  res.header('Access-Control-Allow-Headers', 'Authorization, Content-Type');
  res.header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
 
  if (req.method === 'OPTIONS') return res.sendStatus(200);
 
  const targetUrl = `${BASE_URL}${req.url}`;
  console.log('Proxying:', targetUrl);
 
  axios.get(targetUrl, {
    headers: { Authorization: authHeader },
    maxRedirects: 10,
  })
  .then(response => res.json(response.data))
  .catch(err => {
    console.error('Proxy error:', err.message);
    res.status(500).json({ error: err.message });
  });
});
 
app.listen(3002, () => console.log('✅ Proxy running on http://localhost:3002'));


