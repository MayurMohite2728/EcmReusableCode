[LL_WEBREPORT_EXCLUDEHTML /]<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SPACE - Sobha Process Architect for Collaborative Ecosystem</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--side:#231f20;--ink:#1d1d1f;--muted:#6b6b70;--line:#e3e3e6;--bg:#f6f6f7;--accent:#0f766e;--accent2:#0c5f59;}
*{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:Montserrat,Segoe UI,Arial,sans-serif;color:var(--ink);background:var(--bg)}
.app{display:flex;min-height:100vh}
.side{width:240px;flex:none;background:var(--side);color:#fff;border-radius:14px 0 0 0;margin:12px 0 0 12px;display:flex;flex-direction:column}
.brand{padding:26px 20px 18px;text-align:center;border-bottom:1px solid #4a4546;margin:0 10px}
.brand .logo{font-family:Georgia,'Times New Roman',serif;font-size:58px;letter-spacing:2px;line-height:1}
.brand .tag{font-size:8.5px;opacity:.85;margin-top:4px}
.role{text-align:center;font-weight:600;font-size:15px;padding:18px 10px 40px}
.role i{font-weight:700}
.nav{display:flex;flex-direction:column;gap:14px;padding:0 20px}
.nav button{all:unset;cursor:pointer;display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:4px;color:#bdbdbd;font-size:14px;font-weight:500}
.nav button svg{width:24px;height:24px;flex:none}
.nav button:hover{color:#fff;background:#2f2a2b}
.nav button.active{background:#fff;color:#111;font-weight:600}
.side .foot{margin-top:auto;padding:16px 20px;font-size:11px;color:#8d8d8d}
.main{flex:1;min-width:0;padding:22px 28px 30px;background:#fff;margin-top:12px}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
h1{font-weight:400;font-size:38px;margin:4px 0 18px}
.company{background:#fff;border:1px solid #eee;padding:14px 18px;font-family:Georgia,'Times New Roman',serif;letter-spacing:3px;font-size:19px;white-space:nowrap}
.filters{display:grid;grid-template-columns:120px 1fr 1fr auto;gap:14px 26px;align-items:center;margin-bottom:10px}
.filters label{font-weight:500}
input,select{font:inherit;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:3px;width:100%;background:#fff;color:var(--ink)}
.btns{display:flex;gap:6px}
.btn{all:unset;cursor:pointer;background:#111;color:#fff;font-weight:600;font-size:14px;padding:10px 16px;border-radius:3px;display:inline-flex;gap:8px;align-items:center;white-space:nowrap}
.btn:hover{background:#333}
.btn.teal{background:var(--accent)}.btn.teal:hover{background:var(--accent2)}
.btn.ghost{background:#fff;color:#111;border:1px solid var(--line)}
.dd{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin:18px 0 26px auto;max-width:860px}
.dd div label{display:block;margin-bottom:8px;font-weight:500}
.tablewrap{border:1px solid var(--line);border-radius:3px;overflow:auto}
table{border-collapse:collapse;width:100%;font-size:14.5px}
th{text-align:left;font-weight:600;padding:13px 14px;border-bottom:1px solid var(--line);background:#fafafa;white-space:nowrap;cursor:pointer;user-select:none}
th.nosort{cursor:default}
td{padding:12px 14px;border-bottom:1px solid #eee;white-space:nowrap;max-width:280px;overflow:hidden;text-overflow:ellipsis}
tr:hover td{background:#f7fbfb}
td.view,th.view{text-align:center;width:64px;border-left:1px solid var(--line);position:sticky;right:0;background:#fff}
th.view{background:#fafafa}
.eye{all:unset;cursor:pointer;padding:4px 6px;border-radius:50%}
.eye:hover{background:#e7f2f1}
.pill{display:inline-block;font-size:12px;padding:3px 9px;border-radius:12px;background:#eef3f3;color:#0c5f59}
.pager{display:flex;justify-content:space-between;align-items:center;padding:12px 4px;font-size:13px;color:var(--muted)}
.pager .pg{display:flex;gap:6px;align-items:center}
.pager button{all:unset;cursor:pointer;border:1px solid var(--line);padding:5px 10px;border-radius:3px;color:var(--ink)}
.pager button[disabled]{opacity:.4;cursor:default}
.empty,.loading{padding:40px;text-align:center;color:var(--muted)}
.card{border:1px solid #cfcfd4;border-radius:10px;padding:16px}
.inner{border-radius:12px;box-shadow:0 1px 6px rgba(0,0,0,.12);padding:24px 30px;min-height:500px}
.bar{display:flex;align-items:center;gap:14px;margin-bottom:22px;flex-wrap:wrap}
.crumb{font-size:22px;font-weight:600;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.crumb a{color:var(--ink);text-decoration:none;cursor:pointer}
.crumb a:hover{text-decoration:underline}
.crumb span.sep{color:#999;font-weight:400}
.bar .spacer{flex:1}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:30px 26px}
.tile{cursor:pointer;text-align:center;padding:6px;border-radius:8px}
.tile:hover{background:#f4f6f6}
.tile .nm{margin-top:10px;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tile .dt{font-size:12.5px;color:var(--muted);margin-top:3px}
.folder{position:relative;width:136px;height:96px;margin:0 auto}
.folder .tab{position:absolute;left:0;top:0;width:60px;height:16px;border-radius:6px 8px 0 0}
.folder .body{position:absolute;left:0;right:0;top:9px;bottom:0;border-radius:4px 6px 6px 6px}
.folder .paper{position:absolute;left:6px;right:6px;top:12px;height:4px;background:#fff;border-radius:2px;opacity:.95}
.folder .count{position:absolute;left:10px;bottom:6px;font-size:14px;color:#222}
.doc{width:136px;height:96px;margin:0 auto;display:flex;align-items:center;justify-content:center}
.toast{position:fixed;bottom:22px;right:22px;background:#111;color:#fff;padding:12px 18px;border-radius:6px;font-size:14px;display:none;z-index:9}
.hint{font-size:12.5px;color:var(--muted);margin:-10px 0 18px;display:flex;align-items:flex-start;gap:6px;line-height:1.4}
.hint svg{flex:none;margin-top:2px}
.dropzone{position:relative;transition:background .15s}
.dropzone.drop-over{background:#effaf8;outline:3px dashed var(--accent);outline-offset:-6px;border-radius:12px}
.dropzone.drop-over::after{content:attr(data-drop);position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--accent);color:#fff;padding:12px 22px;border-radius:24px;font-weight:600;font-size:14px;pointer-events:none;box-shadow:0 4px 14px rgba(0,0,0,.18);white-space:nowrap}
.tile.drop-over{background:#d9f2ee;outline:2px dashed var(--accent)}
.ovl{position:fixed;inset:0;background:rgba(20,20,22,.45);display:flex;align-items:center;justify-content:center;z-index:20}
.modal{background:#fff;border-radius:10px;width:min(1040px,94vw);max-height:88vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.25)}
.modal header{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px}
.modal header h2{margin:0;font-size:19px;font-weight:600;flex:1}
.modal .x{all:unset;cursor:pointer;font-size:22px;color:#666;padding:0 6px}
.modal .mb{padding:16px 24px;overflow:auto;flex:1}
.modal .mb.drop-over{background:#effaf8;outline:3px dashed var(--accent);outline-offset:-8px}
.modal footer{padding:14px 24px;border-top:1px solid var(--line);display:flex;gap:10px;align-items:center}
.modal footer .sp{flex:1;font-size:13px;color:var(--muted)}
.uptbl{width:100%;border-collapse:collapse;font-size:13.5px}
.uptbl th{background:#fafafa;padding:9px 8px;font-size:12.5px;cursor:default}
.uptbl td{padding:7px 8px;max-width:none;white-space:normal;vertical-align:middle}
.uptbl input,.uptbl select{padding:7px 8px;font-size:13px}
.uptbl .fn{font-size:11.5px;color:var(--muted);margin-top:3px;word-break:break-all}
.uptbl .rm{all:unset;cursor:pointer;color:#999;font-size:18px;padding:0 4px}
.prog{height:6px;background:#eee;border-radius:3px;overflow:hidden;min-width:90px}
.prog i{display:block;height:100%;width:0;background:var(--accent);transition:width .2s}
.st{font-size:12px;margin-top:4px;color:var(--muted)}
.st.ok{color:#1b7d3a}.st.bad{color:#b3261e}.st.warn{color:#9a6700}
.deptpick{display:flex;gap:12px;align-items:center;margin-bottom:14px}
.deptpick select{max-width:360px}
.cmenu{position:relative}
.cm-list{position:absolute;right:0;top:calc(100% + 6px);background:#fff;border:1px solid var(--line);border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.14);min-width:210px;z-index:15;padding:6px 0}
.cm-list button{all:unset;cursor:pointer;display:flex;align-items:center;gap:10px;width:100%;box-sizing:border-box;padding:10px 16px;font-size:14px;color:var(--ink)}
.cm-list button:hover{background:#eef6f5}
.doc{position:relative}
.doc .thumb{width:120px;height:92px;border:1px solid #d9dcdf;border-radius:6px;overflow:hidden;background:#fff;display:flex;align-items:flex-start;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.doc .thumb img{width:100%;height:100%;object-fit:cover;object-position:top}
.doc .tbadge{position:absolute;right:6px;bottom:-4px;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:3px;letter-spacing:.5px}
.fi{display:inline-block;vertical-align:middle;margin-right:8px}
.nf label{display:block;font-weight:600;margin:4px 0 6px}
.nf .msg{color:#b3261e;font-size:13px;min-height:18px;margin-top:8px}
.err{background:#fdecea;color:#8a1c12;padding:12px 16px;border-radius:4px;margin-bottom:14px;display:none}
@media (max-width:1100px){.dd{margin-left:0}.filters{grid-template-columns:1fr 1fr}.side{width:220px}}
</style>
</head>
<body>
<div class="app">
  <aside class="side">
    <div class="brand"><div class="logo">SPACE</div><div class="tag">Sobha Process Architect for Collaborative Ecosystem</div></div>
    <div class="role">Role: <i id="roleName">Business User</i></div>
    <nav class="nav" id="nav">
      <button data-tab="master" class="active"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="6" width="17" height="14" rx="2"/><rect x="5" y="9" width="5" height="2" fill="#231f20"/><rect x="5" y="13" width="11" height="1.6" fill="#231f20"/><path d="M15 2h7v7h-7z" opacity=".9"/></svg>Master List</button>
      <button data-tab="km"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="6" width="17" height="14" rx="2"/><rect x="5" y="9" width="5" height="2" fill="#231f20"/><rect x="5" y="13" width="11" height="1.6" fill="#231f20"/><path d="M15 2h7v7h-7z" opacity=".9"/></svg>Knowledge Management</button>
      <button data-tab="repo"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="6" width="17" height="14" rx="2"/><rect x="5" y="9" width="5" height="2" fill="#231f20"/><rect x="5" y="13" width="11" height="1.6" fill="#231f20"/><path d="M15 2h7v7h-7z" opacity=".9"/></svg>Central Repository</button>
    </nav>
    <div class="foot" id="userFoot"></div>
  </aside>

  <main class="main">
    <div class="err" id="err"></div>

    <!-- MASTER LIST -->
    <section id="tab-master">
      <div class="top"><h1>All Documents</h1><div class="company">SOBHA UAQ PROPERTIES</div></div>
      <div class="filters">
        <label>Search</label>
        <input id="fNo" placeholder="Document No.">
        <input id="fName" placeholder="Document Name">
        <div class="btns">
          <button class="btn" id="btnExport"><svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M5 20h14v-2H5v2zM12 2l-1.4 1.4L15.2 8H13v8h-2V8H8.8l4.6-4.6z" transform="rotate(180 12 11)"/></svg>Export</button>
          <button class="btn" id="btnAdd"><svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M6 2h9l5 5v15H6z"/></svg>Create File Note</button>
        </div>
      </div>
      <div class="dd">
        <div><label>Department:</label><select id="fDept"><option value="">Select</option></select></div>
        <div><label>Document Level:</label><select id="fLevel"><option value="">Select</option></select></div>
      </div>
      <div class="tablewrap">
        <table>
          <thead><tr>
            <th data-k="name">Document Name</th><th data-k="no">Document Number</th><th data-k="ver">Version Number</th><th data-k="date">Date</th><th data-k="dept">Department</th><th data-k="level">Document Level</th><th class="view nosort">View</th>
          </tr></thead>
          <tbody id="rows"><tr><td colspan="7" class="loading">Loading documents…</td></tr></tbody>
        </table>
      </div>
      <div class="pager"><div id="pgInfo"></div><div class="pg"><button id="pgPrev">&#9664;</button><span id="pgNum"></span><button id="pgNext">&#9654;</button><select id="pgSize" style="width:auto"><option>10</option><option selected>25</option><option>50</option><option>100</option></select></div></div>
    </section>

    <!-- KNOWLEDGE MANAGEMENT -->
    <section id="tab-km" hidden>
      <div class="top"><h1>Knowledge Management</h1><div class="company">SOBHA UAQ PROPERTIES</div></div>
      <div class="card"><div class="inner" id="kmBrowser"></div></div>
    </section>

    <!-- CENTRAL REPOSITORY -->
    <section id="tab-repo" hidden>
      <div class="top"><h1>Central Repository</h1><div class="company">SOBHA UAQ PROPERTIES</div></div>
      <div class="card"><div class="inner" id="repoBrowser"></div></div>
    </section>
  </main>
</div>
<div class="toast" id="toast"></div>

<script>
(function(){
  /* ---------- Configuration ---------- */
  var CFG = {
    base: '/cs/cs',
    repoId: 388498,        /* SPACE > Central Repository */
    kmId: 387064,          /* SPACE > Knowledge Management */
    catId: 388597,         /* Category: SPACE Document Properties */
    attrNo: 2, attrLevel: 3, attrDate: 4,
    fileNoteUrl: '/cs/cs/displayform/2009/122657/127100/127527/?viewid=127661&readonly=false&sedit=false&objId=123327&objAction=EditForm&nexturl=%2Fcs%2Fcs%2Fapi%2Fv1%2Fnodes%2F191232%2Foutput%3Fformat%3Dwebreport'  /* Create File Note form */
  };
  var TICKET = '[LL_REPTAG_OTCSTICKET /]';
  var COLORS = [['#f47c7c','#fda4a4'],['#4ec5c1','#8fe0db'],['#7b3fb5','#b06ee0'],['#ff8a3d','#ffb27a'],['#f5b800','#ffe066'],['#1565c0','#2f8be0'],['#2e7d32','#4fb556'],['#64b5f6','#a8d8fb'],['#57bb6a','#a7dfa9'],['#f08ed6','#ffbdf0'],['#ef6c00','#ff9a3d'],['#d32f2f','#f2553a'],['#9aa0a6','#c7cbcf'],['#00796b','#26a69a'],['#ad1f8a','#d65bc0']];

  /* ---------- helpers ---------- */
  function $(id){return document.getElementById(id);}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function toast(m){var t=$('toast');t.textContent=m;t.style.display='block';clearTimeout(toast._t);toast._t=setTimeout(function(){t.style.display='none';},2500);}
  function showErr(m){var e=$('err');e.textContent=m;e.style.display='block';}
  function api(path){
    return fetch(CFG.base+'/api/'+path,{headers:{OTCSTicket:TICKET},credentials:'same-origin'}).then(function(r){
      var nt=r.headers.get('OTCSTicket'); if(nt) TICKET=nt;
      if(!r.ok) return r.json().catch(function(){return {};}).then(function(j){throw new Error(j.error||('HTTP '+r.status));});
      return r.json();
    });
  }
  function listChildren(id){
    var out=[];
    function page(p){
      return api('v2/nodes/'+id+'/nodes?limit=500&page='+p+'&sort=name'+
        '&fields='+encodeURIComponent('properties{id,name,type,type_name,container,container_size,modify_date,mime_type,parent_id,size_formatted,size}')+
        '&fields=categories'+
        '&fields='+encodeURIComponent('versions{version_number,version_number_major,version_number_minor}')
      ).then(function(j){
        (j.results||[]).forEach(function(r){out.push(r.data);});
        var pg=j.collection&&j.collection.paging;
        if(pg && pg.page_total && p<pg.page_total) return page(p+1);
        return out;
      });
    }
    return page(1);
  }
  function fmtDate(iso){ if(!iso) return ''; var d=new Date(iso.length===19?iso:iso); if(isNaN(d)) return ''; var p=function(n){return (n<10?'0':'')+n;}; return p(d.getDate())+'/'+p(d.getMonth()+1)+'/'+d.getFullYear(); }
  function shortDate(iso){ if(!iso) return ''; var d=new Date(iso); return isNaN(d)?'':d.toLocaleDateString('en-US',{month:'short',day:'numeric'}); }
  function catVal(d,a){ var cs=d.categories||[]; for(var i=0;i<cs.length;i++){ var v=cs[i][CFG.catId+'_'+a]; if(v!==undefined && v!==null) return Array.isArray(v)?v[0]:v; } return ''; }
  function verOf(d){ var v=d.versions; if(!v) return ''; if(!Array.isArray(v)) v=[v]; var m=0; v.forEach(function(x){ if(x && x.version_number>m) m=x.version_number; }); return m||''; }
  function stripExt(n){ return n.replace(/\.(txt|pdf|docx?|xlsx?|pptx?|msg|vsdx?)$/i,''); }
  function url(q){ return CFG.base+'?'+q; }
  function viewUrl(id,mime){ return /pdf|word|excel|powerpoint|officedocument|image|tiff/i.test(mime||'') ? url('func=doc.ViewDoc&nodeId='+id) : url('func=ll&objId='+id+'&objAction=Open'); }
  function propsUrl(id){ return url('func=ll&objId='+id+'&objAction=properties'); }
  function browseUrl(id){ return CFG.base+'/app/nodes/'+id; }
  function addDocUrl(parent){ return url('func=ll&objType=144&objAction=create&parentId='+parent+'&nextURL='+encodeURIComponent(location.pathname+location.search)); }

  /* ---------- tabs ---------- */
  var loaded={};
  function switchTab(t){
    [].forEach.call(document.querySelectorAll('#nav button'),function(b){b.classList.toggle('active',b.getAttribute('data-tab')===t);});
    ['master','km','repo'].forEach(function(x){$('tab-'+x).hidden=(x!==t);});
    try{ history.replaceState(null,'',location.pathname+location.search.replace(/&tab=\w+/,'')+'&tab='+t); }catch(e){}
    if(t==='repo' && !loaded.repo){ loaded.repo=true; repo.open(CFG.repoId,'CentralRepository'); }
    if(t==='km' && !loaded.km){ loaded.km=true; km.open(CFG.kmId,'Knowledge Management'); }
  }
  [].forEach.call(document.querySelectorAll('#nav button'),function(b){b.onclick=function(){switchTab(b.getAttribute('data-tab'));};});

  /* ---------- MASTER LIST ---------- */
  var ALL=[], VIEW=[], page=1, sortK='date', sortDir=-1;
  function walk(folderId, dept){
    return listChildren(folderId).then(function(items){
      var subs=[];
      items.forEach(function(d){
        var p=d.properties;
        if(p.container){ subs.push(walk(p.id, dept||p.name)); }
        else if(dept){
          ALL.push({id:p.id,name:stripExt(p.name),fullName:p.name,no:catVal(d,CFG.attrNo),level:catVal(d,CFG.attrLevel),
            dateIso:catVal(d,CFG.attrDate)||p.modify_date,ver:verOf(d),dept:dept,deptId:null,type:p.type,mime:p.mime_type});
        }
      });
      return Promise.all(subs);
    });
  }
  var DEPTS={};
  function refreshMaster(){ ALL=[]; return walk(CFG.repoId,null).then(applyFilters); }
  function loadMaster(){
    ALL=[];
    listChildren(CFG.repoId).then(function(depts){
      var sel=$('fDept'); depts.filter(function(d){return d.properties.container;}).forEach(function(d){
        DEPTS[d.properties.name]=d.properties.id; var o=document.createElement('option');o.value=d.properties.name;o.textContent=d.properties.name;sel.appendChild(o);
      });
      return walk(CFG.repoId,null);
    }).then(function(){
      var lv={}; ALL.forEach(function(r){ if(r.level) lv[r.level]=1; });
      ['Policy','Process','Procedure','Guideline','Authority Matrix','Work Instruction','Form / Template'].forEach(function(l){lv[l]=1;});
      Object.keys(lv).forEach(function(l){var o=document.createElement('option');o.value=l;o.textContent=l;$('fLevel').appendChild(o);});
      applyFilters();
    }).catch(function(e){ showErr('Could not load documents: '+e.message); $('rows').innerHTML='<tr><td colspan="7" class="empty">Unable to load documents.</td></tr>'; });
  }
  function applyFilters(){
    var no=$('fNo').value.trim().toLowerCase(), nm=$('fName').value.trim().toLowerCase(), dp=$('fDept').value, lv=$('fLevel').value;
    VIEW=ALL.filter(function(r){
      return (!no||String(r.no).toLowerCase().indexOf(no)>-1)&&(!nm||r.name.toLowerCase().indexOf(nm)>-1)&&(!dp||r.dept===dp)&&(!lv||r.level===lv);
    });
    VIEW.sort(function(a,b){ var x=sortK==='date'?a.dateIso:a[sortK], y=sortK==='date'?b.dateIso:b[sortK]; x=x==null?'':x; y=y==null?'':y; return (x>y?1:x<y?-1:0)*sortDir; });
    page=1; render();
  }
  function render(){
    var size=+$('pgSize').value, pages=Math.max(1,Math.ceil(VIEW.length/size)); if(page>pages) page=pages;
    var slice=VIEW.slice((page-1)*size,page*size);
    $('rows').innerHTML = slice.length? slice.map(function(r){
