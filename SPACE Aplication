    if(/^xlsx?$|^xlsm$|^csv$|^ods$/.test(e)||/excel|spreadsheet/.test(mime)) return {l:'XLS',c:'#217346',k:'office'};
    if(/^pptx?$|^odp$/.test(e)||/powerpoint|presentation/.test(mime)) return {l:'PPT',c:'#d24726',k:'office'};
    if(/^(png|jpe?g|gif|bmp|webp|svg)$/.test(e)||/^image\//.test(mime)) return {l:'IMG',c:'#8e44ad',k:'image'};
