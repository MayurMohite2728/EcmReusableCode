    function watch(el,p){ el._p=p; if(fileType(p.name,p.mime_type).k==='other') return; if(io) io.observe(el); else { q.push(el); pump(); } }
    function pump(){ while(active<MAX && q.length){ var el=q.shift(); active++; load(el).catch(function(){}).then(function(){ active--; pump(); }); } }
    function show(el,src){ if(!el.isConnected||!src) return; var t=fileType(el._p.name,el._p.mime_type); el.innerHTML='<div class="thumb"><img alt="Preview of '+esc(el._p.name)+'" src="'+src+'"></div><span class="tbadge" style="background:'+t.c+'">'+t.l+'</span>'; }
    function getBlob(path){ return fetch(CFG.base+'/api/'+path,{headers:{OTCSTicket:TICKET}}).then(function(r){ if(!r.ok) throw new Error(r.status); return r.blob(); }); }
    function pdfLib(){
      if(!pdfP) pdfP=new Promise(function(res,rej){ if(window.pdfjsLib) return res(window.pdfjsLib); var s=document.createElement('script'); s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js'; s.onload=function(){ window.pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js'; res(window.pdfjsLib); }; s.onerror=rej; document.head.appendChild(s); });
      return pdfP;
    }
    function load(el){
      var p=el._p, key=p.id+'|'+p.modify_date, t=fileType(p.name,p.mime_type);
      if(cache[key]) { show(el,cache[key]); return Promise.resolve(); }
      var big=(p.size||0)>25*1048576, job;
      if(t.k==='image' && !big) job=getBlob('v2/nodes/'+p.id+'/content').then(function(b){ return URL.createObjectURL(b); });
      else if(t.k==='pdf' && !big) job=Promise.all([pdfLib(),getBlob('v2/nodes/'+p.id+'/content').then(function(b){return b.arrayBuffer();})]).then(function(a){
          return a[0].getDocument({data:a[1]}).promise.then(function(doc){ return doc.getPage(1); }).then(function(pg){
            var v0=pg.getViewport({scale:1}), vp=pg.getViewport({scale:240/v0.width}), c=document.createElement('canvas'); c.width=vp.width; c.height=vp.height;
            return pg.render({canvasContext:c.getContext('2d'),viewport:vp}).promise.then(function(){ return c.toDataURL('image/png'); });
          });
        });
      else job=getBlob('v1/nodes/'+p.id+'/thumbnails/medium/content').then(function(b){ if(!/^image\//.test(b.type)) throw 0; return URL.createObjectURL(b); });
      return job.then(function(src){ cache[key]=src; show(el,src); });
    }
    return {watch:watch};
  })();

  /* ---------- CREATE FOLDER ---------- */
  function newFolder(parentId,parentName,onDone){
    var ovl=document.createElement('div'); ovl.className='ovl';
    ovl.innerHTML='<div class="modal nf" role="dialog" aria-label="Create folder" style="width:min(480px,94vw)"><header><h2>Create folder</h2><button class="x" title="Close">×</button></header>'+
      '<div class="mb"><div style="font-size:13px;color:var(--muted);margin-bottom:12px">In: <b style="color:var(--ink)">'+esc(parentName)+'</b></div>'+
      '<label for="nfName">Folder name *</label><input id="nfName" maxlength="248" autocomplete="off">'+
      '<label for="nfDesc" style="margin-top:14px">Description</label><input id="nfDesc" autocomplete="off"><div class="msg"></div></div>'+
      '<footer><span class="sp"></span><button class="btn ghost" data-cancel>Cancel</button><button class="btn teal" data-go>Create</button></footer></div>';
    document.body.appendChild(ovl);
    var nm=ovl.querySelector('#nfName'), ds=ovl.querySelector('#nfDesc'), msg=ovl.querySelector('.msg'), go=ovl.querySelector('[data-go]'), busy=false;
    function close(){ if(!busy) ovl.remove(); }
    ovl.querySelector('.x').onclick=close; ovl.querySelector('[data-cancel]').onclick=close;
    ovl.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); if(e.key==='Enter') submit(); });
    go.onclick=submit; setTimeout(function(){ nm.focus(); },30);
    function submit(){
      if(busy) return; var n=nm.value.trim();
      if(!n){ msg.textContent='Please enter a folder name.'; nm.focus(); return; }
      if(/[:]/.test(n)){ msg.textContent='Folder name cannot contain ":"'; return; }
      busy=true; go.textContent='Creating…'; msg.textContent='';
      var fd=new FormData(); fd.append('body',JSON.stringify({type:0,parent_id:parentId,name:n,description:ds.value.trim()}));
      xhrSend('POST','v2/nodes',fd).then(function(j){
        var id=j.results&&j.results.data&&j.results.data.properties&&j.results.data.properties.id;
        if(parentId===CFG.repoId && id){ DEPTS[n]=id; var o=document.createElement('option'); o.value=n; o.textContent=n; $('fDept').appendChild(o); }
        busy=false; ovl.remove(); toast('Folder "'+n+'" created'); if(onDone) onDone();
      }).catch(function(e){ busy=false; go.textContent='Create'; msg.textContent=/exists|already/i.test(e.message)?'A folder or item with this name already exists here.':e.message; });
    }
  }

  /* ---------- user ---------- */
  api('v1/auth').then(function(j){ var d=j.data||{}; var n=((d.first_name||'')+' '+(d.last_name||'')).trim()||d.name; $('userFoot').textContent='Signed in as '+n; }).catch(function(){});

  /* ---------- start ---------- */
  loadMaster();
  var m=location.search.match(/[&?]tab=(\w+)/); if(m && m[1]!=='master') switchTab(m[1]);
})();
</script>
