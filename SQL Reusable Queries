DECLARE @WorkflowParentID int;
DECLARE @DataRequestName varchar(200);
SET @WorkflowParentID='587489338';
SET @DataRequestName =(select name from dtree where dataid=@WorkflowParentID)
/*Collection Set */
select distinct dt.DataID 'ExternalObjectID',dt.Name 'Filename',
dt.versionnum 'ExternalObjectVersionID', dv.DataSize 'Size',@DataRequestName+'/'+DTp.Name+'/'+[otcs].[CT_GetLLNodePath](dt.DataID,c.DataID) 'TargetPath',dt.ModifyDate LastModified from
DTree DTp
join Collections c on DTp.DataID=c.CollectionID
left join DTreeAncestors dta on dta.AncestorID=c.DataID
left join dtree dt on dt.DataID=dta.DataID
left join DVersData dv on dt.DataID=dv.DocID
join DTree ct on ct.DataID=c.DataID
where c.CollectionID=DTp.DataID and dv.VerType is null and dv.Version=dt.VersionNum
and dt.DataID is not null and dt.SubType in(144,736) and DTp.ParentID=@WorkflowParentID and DTp.SubType=298
and ct.SubType not in(144,736)
UNION ALL
/*Collection inside Collection */
select distinct dtrc.DataID 'ExternalObjectID',dtrc.Name 'Filename',
dtrc.versionnum 'ExternalObjectVersionID', dv.DataSize 'Size',@DataRequestName+'/'+DTp.Name+'/'+
[otcs].[CT_GetLLNodePath](dt.ParentID,c.DataID)
+'/'+dt.Name+'/'+
[otcs].[CT_GetLLNodePath](dtrc.DataID,c2.DataID) 'TargetPath',dtrc.ModifyDate LastModified
from DTree DTp
join Collections c on DTp.DataID=c.CollectionID
left join DTreeAncestors da on da.AncestorID=c.DataID
left join dtree dt on dt.DataID=da.DataID
left join Collections c2 on c2.CollectionID=dt.DataID
left join dtree dt2 on dt2.dataid=c2.DataID
left join DTreeAncestors dtc on dtc.AncestorID=c2.DataID
left join dtree dtrc on dtrc.DataID=dtc.DataID  and dtrc.SubType=144
left join DVersData dv on dtrc.DataID=dv.DocID
where  dtp.ParentID=@WorkflowParentID and 
dt.SubType=298 and  dtp.SubType=298   and dv.VerType is null and dv.Version=dtrc.VersionNum and dt2.SubType!=144
UNION all
select distinct dt.DataID 'ExternalObjectID',dt.Name 'Filename',
dt.versionnum 'ExternalObjectVersionID', dv.DataSize 'Size',@DataRequestName+'/'+REPLACE(DTp.Name,'/','_')  'TargetPath',dt.ModifyDate LastModified from
DTree DTp
join Collections c on DTp.DataID=c.CollectionID
left join DTreeAncestors dta on dta.AncestorID=c.DataID
left join dtree dt on dt.DataID=dta.DataID
