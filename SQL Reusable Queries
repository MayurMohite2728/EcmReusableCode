select distinct dtrc.DataID 'ExternalObjectID',dtrc.Name 'Filename',
dtrc.versionnum 'ExternalObjectVersionID', dv.DataSize 'Size',@DataRequestName+'/'+DTp.Name+'/'+
[otcs].[CT_GetLLNodePath](dt.ParentID,c.DataID)
+'/'+REPLACE(dt.Name,'/','_') 'TargetPath',dtrc.ModifyDate LastModified
from DTree DTp
join Collections c on DTp.DataID=c.CollectionID
left join DTreeAncestors da on da.AncestorID=c.DataID
