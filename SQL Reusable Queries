SELECT distinct 
    u.MailAddress
FROM KUAF g
JOIN KUAFChildren gc 
    ON gc.ID = g.ID        -- group
JOIN KUAF u 
    ON u.ID = gc.ChildID         -- users inside the group
WHERE g.Name = '01 Workspace Manager'
  AND u.MailAddress IS NOT NULL
  AND u.Type = 0 
  AND u.Deleted = 0
  and u.MailAddress like '%@ashghal.gov.qa'


