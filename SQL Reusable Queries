--Total Docs--

select SUM(dv.DataSize) SizeOfDocsCreated,count(dt.dataid) NumberOfDocumentsCreated from DTree dt

inner join DVersData dv on dt.DataID=dv.DocID and dt.VersionNum=dv.Version

where 

dv.VerType is null and dt.SubType in(143,144,145,749,736);


 
--Total docs including versions--

select count(dv.versionid) from DTreeCore dt

inner join DVersData dv on dt.DataID=dv.DocID 

where  

dt.SubType in(143,144,145,749,736);



