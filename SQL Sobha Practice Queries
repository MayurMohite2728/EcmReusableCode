6.SELECT
    U.NAME AS UserName,
    G.NAME AS Department
FROM KUAF U
JOIN KUAFCHILDREN KC ON U.ID = KC.CHILDID
JOIN KUAF G ON KC.ID = G.ID
WHERE G.NAME IN (
    'PMO Office',
    'Project Execution',
    'Planning',
    'BE',
    'Commercial',
    'Technical',
    'Project Admin',
    'Stores',
    'QAD',
    'Estimation',
    'QAQC',
    'P&M',
    'HSSE'
);

