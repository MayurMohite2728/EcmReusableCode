SELECT 
    k.Name AS "Login Name",
    k.FirstName  as  "Full Name",
    COUNT(d.AuditStr) AS "Count of Actions"
FROM DAuditNew d
INNER JOIN KUAF k
    ON k.ID = d.PerformerID
WHERE k.ID <> 1000
GROUP BY 
    k.Name,
    k.FirstName,
    k.LastName,
    k.mailaddress
order by count(d.auditstr)
