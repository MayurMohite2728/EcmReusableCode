SELECT
    T.Work_WorkID                AS WorkflowID,
    T.SubWorkTask_TaskID         AS TaskID,
    T.SubWorkTask_Title          AS CurrentTask,
    T.SubWorkTask_PerformerID    AS PerformerID,
    K.Name                       AS PerformerName,
    K.MailAddress                AS Email
FROM Todo T
INNER JOIN KUAF K
    ON K.ID = T.SubWorkTask_PerformerID
WHERE T.Work_WorkID = 102797;








