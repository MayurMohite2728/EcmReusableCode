SELECT
    CASE subtype
        WHEN 0 THEN 'Folder'
        WHEN 144 THEN 'Document'
        WHEN 202 THEN 'Project'
        ELSE 'Not Specified'
    END AS Type,
    COUNT(subtype) AS Number
FROM DTree
WHERE subtype IN (0, 144, 202)
GROUP BY subtype
ORDER BY Number DESC;

