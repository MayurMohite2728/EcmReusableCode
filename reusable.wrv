[/* content 
  1.Create bussiness workspace using tag 
  2.Hide add item using csui method -Web report css.
  3.Create groups and subgroups to the folder.
  4.Aunthetication api call to the same content server restclient format 
  5. runninginworkflow workflow paratmeter
  6.To hide the add item paramter (whole code)
  7.Giving Permisson to workflow all users role for attachment.
  8.Setting category values based on CSV with multifiled value comma seperated . 
  9.Bulk wfaction
  10.Delete latest version
  11.Redirect workflow through power view . 
  12.Listing iteams in Perspectives
13.Attahcment iteams action on this : any action 
 */]




[//  1. to create bussiness workspace using web report tag /]
[LL_REPTAG_"" CWSACTION:CREATE:130535048:130534828:130462761:'[LL_REPTAG_!Month /][LL_REPTAG_!Year /]':'':130452959 /]
[// ===========================================================================================================================

[// 2. to hide the add iteam iteam using web report . 
'csui/utils/toolitem.masks/creation.toolitems.mask':{
                'custom': { blacklist: [
                    {signature: 'AddEmailFolder',commandData: {type: 751}},
                    {signature: 'Add',commandData: {type: 298}},
                    {signature: 'Add',commandData: {type: 144}},
                    {signature: 'AddWiki',commandData: {type: 5573}}
                ]}
                },

[//  
  

  [// 3. Create groups and subgroups to the folder. /]


  [LL_REPTAG_&FOLDER_ID SETVAR:FOLDERID /]
[LL_REPTAG_&GRPBASENAME SETVAR:ROOTPERM /]

[LL_REPTAG_'[LL_REPTAG_!ROOTPERM /]:04 Workspace Manager' USERACTION:CREATEGROUP SHOW SETVAR:WorkspaceManager /] 
[LL_REPTAG_'[LL_REPTAG_!ROOTPERM /]:02 Contributor' USERACTION:CREATEGROUP:LEADERID:[LL_REPTAG_!WorkspaceManager /] SHOW SETVAR:Contributor /]
[LL_REPTAG_'[LL_REPTAG_!ROOTPERM /]:03 ContributorFull' USERACTION:CREATEGROUP:LEADERID:[LL_REPTAG_!WorkspaceManager /] SHOW SETVAR:ContributorFull /]
[LL_REPTAG_'[LL_REPTAG_!ROOTPERM /]:01 Consumer' USERACTION:CREATEGROUP:LEADERID:[LL_REPTAG_!WorkspaceManager /] SHOW SETVAR:Consumer /]

[//APPLY PERMISSION ON CREATED FOLDER
[LL_REPTAG_!FOLDERID PERMACTION:ACL:[LL_REPTAG_!Consumer /]:UPDATE:"SEE,SEECONTENTS" /]
[LL_REPTAG_!FOLDERID PERMACTION:ACL:[LL_REPTAG_!Contributor /]:UPDATE:"SEE,SEECONTENTS,MODIFY,EDITATTRS,ADDITEMS,RESERVE,ADDMAJORVERSION" /]
[LL_REPTAG_!FOLDERID PERMACTION:ACL:[LL_REPTAG_!ContributorFull /]:UPDATE:"SEE,SEECONTENTS,MODIFY,EDITATTRS,ADDITEMS,RESERVE,ADDMAJORVERSION,DELETEVERS,DELETE" /]
[LL_REPTAG_!FOLDERID PERMACTION:ACL:[LL_REPTAG_!WorkspaceManager /]:UPDATE:"SEE,SEECONTENTS,MODIFY,EDITATTRS,ADDITEMS,RESERVE,ADDMAJORVERSION,DELETEVERS,DELETE,EDITPERMS" /]

[// 4.Authentication api call to the same api call restclient 


[LL_REPTAG_{ { "content-type", "application/json" } } ASSOCACTION:CREATE SETVAR:otheader /]
    [LL_WEBREPORT_RESTCLIENT
    @HOST:'[LL_REPTAG_$OTDSEndpoint /]'
    @SECURE:FALSE
    @PORT:80
    @URI:'/otdsws/rest/authentication/credentials'
    @METHOD:POST
    @TIMEOUT:10
    @HEADER:[LL_REPTAG_!otheader /]
    @BODY:'{"userName":"[LL_REPTAG_$OTDSServiceAccount /]","password":"[LL_REPTAG_$OTDSServiceAccountPassword /]"}'
    @OUTPUT:ASSOC:AuthAssoc /]
    [LL_REPTAG_!AuthAssoc ASSOC:ticket SETVAR:otdsticket /]
[LL_REPTAG_!otdsticket /]

[// ================================================================== 5 =======================================================


[// when we call worfflow from outside of web report we have to use the paramter. runninginworkflow /]


[// 6.To hide the add item paramter

[/* Title: Blank Reportview */]
[LL_WEBREPORT_EXCLUDEHTML /]
<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
 
[// Load below two Supporting files for SMART UI to work
[//<script src="[LL_REPTAG_URLPREFIX /]/widgets?crossOrigin=true"></script>
<script src="http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_URLPREFIX /]/widgets?crossOrigin=true"></script>   
<link rel="stylesheet" href="http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_SUPPORTDIR /]csui/themes/carbonfiber/theme.css">
[// HTML Section 
<title>[LL_REPTAG_&folderid NODEINFO:NAME /]</title>
 
[// Initializing the Folder Browser Widget with default Parameters
<script>
    csui.onReady2([
                'csui/integration/folderbrowser/folderbrowser.widget'
            ], function (FolderBrowser) {
                [// To Add the Back Button Start
                var config = new csui.require.config({
          config: {
            "csui/integration/folderbrowser/commands/go.to.node.history": {
              enabled: true,
                }, 
            },
            });
            [// To Add the Back Button End
                var folderBrowser = new FolderBrowser({
                     connection: {
                         url: 'http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_URLPREFIX /]/api/v1', [// API Endpoint for initialization 
                         supportPath: 'http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_SUPPORTDIR /]', [// Support Path Folder
                         session:{
                             ticket:'[LL_REPTAG_OTCSTICKET /]'  [// Logged in users ticket
                         }
                          },
                    start: {
                        id: [LL_REPTAG_&folderid /]  [// Folder ID to Load is send as a parameter
                    },
                    breadcrumb: false,   [// change to true if breadcrumd is required
                    showPageInfo:true,
                    config:config  [// To Add the Back Button
                });
                folderBrowser.show({
                    placeholder: '#content'  [//ID for the DIV to load this Widget
                })
            });
</script>
</head>
[//HTML Section , where we have create the DIV using the CarbonTheeme CSS Classes
<body >
<div class="binf-container-fluid grid-rows">
<div class="binf-row">
<div id="content" class="row-xs-full"></div>
</div>
</div>
</body>
</html>

[LL_WEBREPORT_STARTROW /]
[LL_WEBREPORT_ENDROW /]

[// =============================================================== 6 ============================================================

7.Giving Permisson to workflow all users role for attachment. 

[/* This webreport will provide EDITATTRS permissions to all workflow roles on attachments folder and its subitems */]
[LL_WEBREPORT_FOR DATA:[LL_REPTAG_{[LL_REPTAG_&WorkID /],[LL_REPTAG_&WorkID /],0} WFTASKINFO:TASKINFO RECORD:map_userdata ASSOC:LL_Role ASSOC:Data ASSOC:RolePerformers  /] VAR:iRole /]
    [LL_REPTAG_&WorkID WFINFO:ATTACHFOLDER SETVAR:AttchFolderID SHOW PERMACTION:ACL:[LL_REPTAG_!iRole /]:UPDATE:EDITATTRS /]
    [LL_WEBREPORT_FOR DATA:[LL_REPTAG_&WorkID WFINFO:ATTACHFOLDER NODEINFO:CHILDREN /] VAR:iDoc /]
        [LL_REPTAG_!iDoc RECORD:DataID PERMACTION:ACL:[LL_REPTAG_!iRole /]:UPDATE:EDITATTRS /]
    [LL_WEBREPORT_ENDFOR /]
[LL_WEBREPORT_ENDFOR /]


[// =======================================================================7 ==========================================================


8.CSV Multifield value setting . 

   
   [LL_WEBREPORT_FOR DATA:[LL_REPTAG_DATASOURCE /] VAR:i /]
   
        [LL_REPTAG_!i RECORD:'Proposed project code' SETVAR:PPC /]<br>
         
        [LL_REPTAG_!i RECORD:'project request code' SETVAR:PRCCODE /]<br>
         
          [LL_REPTAG_!i RECORD:'CdmsNodeID' SETVAR:CDMSID /]<br>
   
   
            [LL_WEBREPORT_FOR DATA:[LL_REPTAG_!PRCCODE TOLIST:"," /] VAR:j /]
          
         
                 [LL_WEBREPORT_IF "[LL_REPTAG_!j_index SUBTRACT:1  /]" == "0" /]
                 
                  [LL_REPTAG_!CDMSID CATACTION:SETVALUE:"Proposed Project":"Project Request":[LL_REPTAG_!j_index /]:"[LL_REPTAG_%j CURRENTVAL /]" /]
        
                 [LL_WEBREPORT_ELSE /]
         
                   [LL_REPTAG_!CDMSID CATACTION:INSERTVALUE:"Proposed Project":"Project Request":[LL_REPTAG_!j_index /]:"[LL_REPTAG_%j CURRENTVAL /]" /]
                
                 [LL_WEBREPORT_ENDIF /]
        
            [LL_WEBREPORT_ENDFOR /]
      
   [LL_WEBREPORT_ENDFOR /]

=============================================== 8 =====================================================================================

[//Bulk workflow action

[/* Title: Blank Reportview */]

[LL_WEBREPORT_STARTROW /]
[LL_REPTAG_1 /],[LL_REPTAG_2 /],[LL_REPTAG_3 /],[LL_REPTAG_4 /] <BR>
