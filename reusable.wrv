<script>


$(document).ready(function(){
    generateReport();
   
});
//Declaring All Variables Globally
const urlPrefix = '[LL_REPTAG_URLPREFIXFULL /]';
const detailSubWR = '[LL_REPTAG_$DetailSubWR /]';
const reportId = '[LL_REPTAG_$ResultsWebReportID /]';
const baseUrl = '[LL_REPTAG_URLPREFIXFULL /]/info/';
let expandedRows = {};
let mainRowTotals = {};


// For '+' button for expansion
const operateFormatter = (value, row) => {
    if (row.isSubRow) return ''; // Don't show buttons for sub-rows
    const buttonText = expandedRows[row.id] ? '-' : '+'; // Check if the row is expanded
    return `<button class="btn btn-primary btn-sm add-row" type="button">${buttonText}</button>`;
};

function formatRow(value, row, index) {
    const rowData = encodeURIComponent(JSON.stringify(row));
    return `<button class="btn btn-primary btn-sm" onclick="toggleSubRows(${index}, '${rowData}')">+</button>`;
}




//Calling Main Webreport for getting Data
async function generateReport() {
    console.log('generateReport called');
    $(".loader").show(); // Show loader
    const fullUrl = `${urlPrefix}?func=ll&objId=${detailSubWR}&objAction=RunReport`;
    try {
        const data = await fetchData(fullUrl);
        handleDataResponse(data);
    } catch (error) {
        handleError(error);
    } finally {
        $(".loader").hide(); // Hide loader
    }
}




//Displaying Sub Rows -  Comment
async function toggleSubRows(index, mainRowJson) {
    const mainRow = JSON.parse(decodeURIComponent(mainRowJson));
    const workid = mainRow?.workid;
    const includeMS = String(mainRow?.map_mapobjid) === String('[LL_REPTAG_$MSWR /]');
    console.log("WorkID:", workid, "IncludeMS:", includeMS);

    // ... (rest of your existing toggleSubRows code)

    // Try to find the row using the `data-workid` attribute
    let rowElement = $(`#report tbody tr[data-workid="${workid}"]`);

    
    if (!rowElement.length) {
        console.error(`Row not found for WorkID: ${workid}`);
        return;
    }

    let btn = rowElement.find("button");

    if (!btn.length) {
        console.error(`Button not found for WorkID: ${workid}`);
        return;
    }

    if (btn.text() === "+") {
        try {
            console.log(`🔍 Fetching subrows for WorkID: ${workid}`);

            let subData = await fetchSubRows(workid, includeMS);

            if (!subData || subData.length === 0) {
                console.warn(`No Subrows found for WorkID: ${workid}`);
                alert("No Tasks to Display");
                return;
            }

            let subRowsHtml = `
                <tr class="sub-header subrow-${workid}" style="background-color: #f0f8ff; font-weight: bold;">
                    <td></td>
                    <td>WF Task Name</td>
                    <td>Task Performer</td>
                    <td>Task Start Date</td>
                    <td>Task Completed Date</td>
                    <td>Task Due Date</td>
                    <td>WF Comments</td>
                </tr>
            `;

            subData.forEach(sub => {
                subRowsHtml += `
                    <tr class="subrow-${workid}">
                        <td></td>
                        <td>${sub.WFTitle || "-"}</td>
                        <td>${sub.Task_Performer || "-"}</td>
                        <td>${formatDisplayDate(sub.SubWorkTask_DateReady)}</td>
                        <td>${formatDisplayDate(sub.SubWorkTask_DateDone)}</td>
                        <td>${sub.Task_DueDate != null ? sub.Task_DueDate : "-"}</td>
                        <td>${sub.Task_Comments || "-"}</td>
                    </tr>
                `;
                 
            });

            // Insert after the correct row
            rowElement.after(subRowsHtml);
            btn.text("-"); // Change button to collapse state

        } catch (error) {
            console.error(`Error fetching subrows for WorkID: ${workid}`, error);
        }
    } else {
        // Remove subrows when collapsing
        $(`.subrow-${workid}`).remove();
        btn.text("+");
    }
}

//Date formatting for Approved Date etc..
function formatDates(value, row, index, field) {
    if (!value) return ""; // If there's no date, return empty
    
    let formattedDate = value.split('T')[0]; // Extract only the date part (YYYY-MM-DD)
    return `<span>${formattedDate}</span>`;
}

function formatDisplayDate(value) {
    if (!value) return "";
    const date = new Date(value);
    if (isNaN(date)) return value; // Return original if invalid

    const day = String(date.getDate()).padStart(2, '0');
    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const month = monthNames[date.getMonth()];
    const year = date.getFullYear();

    return `${day}-${month}-${year}`;
}


//Redirecting URL for Document Number to open a document
function formatDocumentNumber(value, row) {
    if (!row.Document_Number || !row.WF_ValInt) return "-"; 

    let docUrl = `${urlPrefix}/info/${row.WF_ValInt}`;
    return `<a href="${docUrl}" target="_blank">${row.Document_Number}</a>`; 
}

//Redirecting URL for Title to Open WF
function formatTitle(value, row) {
    if (!row.Title); 

    let docUrl = `${urlPrefix}?func=work.statusheader&workid=${row.workid}&subworkid=${row.subworkid}`;
    return `<a href="${docUrl}" target="_blank">${row.Title}</a>`; 
}




// Function to fetch sub rows
async function fetchSubRows(workid, includeMS = false) {
    if (!workid) {
        console.error("fetchSubRows: WorkID is undefined");
        return [];
    }

    const includeFlag = includeMS ? 'true' : 'false';
    const url = `${urlPrefix}?func=ll&objId=${reportId}&inputlabel1=${workid}&IncludeMS=${includeFlag}&objAction=RunReport`;

    console.log("Fetching subrow data from:", url);

    try {
        const subData = await fetchData(url);
        return await transformResults(subData.myRows || [], true);
    } catch (error) {
        console.error("fetchSubRows Error:", error);
        return [];
    }
}




async function fetchData(url) {
    console.log(`Fetching data from: ${url}`);
    try {
        const response = await $.ajax({ url, dataType: 'json' });
        if (!response.success) {
            throw new Error('API call failed');
        }
        if (!Array.isArray(response.myRows)) {
            throw new Error('Unexpected API response format');
        }
        return response;
    } catch (error) {
        showMessage(`Failed to load data. Error: ${error.message}`);
        console.error("Error fetching data:", error);  // Log the error for debugging
        throw error;
    }
}


function handleDataResponse(data) {
    console.log("Data received:", data);  // Check the response data
    const results = data.myRows;
    if (results.length === 0) {
        showMessage('No data available.');
        return;
    }
    initializeTable(results);
}


// To Get tableData
async function initializeTable(results) {
    console.log("Initializing table with results:", results);  // Check if results are valid

    try {
        const tableData = await transformResults(results, false);
        
        // Check if the table is already initialized
        if ($('#report').data('bootstrap.table')) {
            $('#report').bootstrapTable('load', tableData); // Load new data
        } else {
            // Initialize the table if not already initialized
            $('#report').bootstrapTable({
                data: tableData,
                pageSize: 50,
                undefinedText: '',
                columns: getTableColumns(),
                rowAttributes: function (row, index) {
                    return {
                        'data-workid': row.workid  // Ensure each row has a data-workid attribute
                    };
                },
                onPostBody: function () {
                    console.log("Table rendered");
                }
            
            
});

        }
    } catch (error) {
        showMessage('Failed to initialize table.');
    }
}



//Columns that are displayed & returned from Another webreport in JSON format
function getTableColumns() {
    return [
        { field: 'expand', title: '', width: 50, formatter: formatRow, align: 'center', filterControl: false },
        { field: 'SubWork_Title', title: 'Workflow Title', filterControl: 'input' }, // This one has filterControl as input
        { field: 'Initiator', title: 'WF Owner', filterControl: false },
        { field: 'SubWork_DateInitiated', title: 'WF Initiated Date', sortable: true, filterControl: false, formatter: formatDisplayDate },
        { field: 'SubWork_DateCompleted', title: 'WF Completed Date', sortable: true, filterControl: false, formatter: formatDisplayDate },
        { field: 'Status', title: 'Workflow Status', filterControl: true }
        
    ];
}





function handleError(error) {
    showMessage(`Failed to load data. Error: ${error.message}`);
}

function showMessage(message) {
    $(".loader").hide();
    $("#messageWrapper").text(message).show(10);
}


//Handling entire Data & Logics
async function transformResults(results, isSubRow = false) {
    const transformedResults = results.map((result, index) => {
        if (isSubRow) {
            return {
                id: `sub_${result.subwork_subworkid}_${index}`,
                WFTitle: result.subworktask_title,
                Task_DueDate: result.late,
                Task_Performer: result.performer,
                Task_Comments: result.comments,
                SubWorkTask_DateReady: result.subworktask_dateready,
	            SubWorkTask_DateDone: result.subworktask_datedone,
                isSubRow,
                dataType: result.Data
            };
        } else {
            const mapObjId = result.map_mapobjid || '';
            return {
                id: `main_${index}`,
                workid: result.subwork_subworkid || `workid_${index}`,
                SubWork_Title: result.subwork_title || '', 
                SubWork_DateCompleted: result.subwork_datecompleted || '',
                Initiator: result.initiator || '',
                SubWork_DateInitiated: result.subwork_dateinitiated || '',
                Status: result.status || '',
                isSubRow,
                map_mapobjid: mapObjId, // Add map_mapobjid for later check
            };
        }
    });
    console.log("Transformed Data:", transformedResults);
    return transformedResults;
}


//To export it to Excel  
$(document).ready(async function() {
    await generateReport(); // Load data when the document is ready
});

document.addEventListener("DOMContentLoaded", function () {
    let exportBtn = document.getElementById("exportCsvBtn");

    if (exportBtn) {
        exportBtn.addEventListener("click", function () {
            exportXLSXFile();  
        });
    } else {
        console.error("Error: Export button not found in the DOM!");
    }
});

  
    function exportXLSXFile() {

    let tableRows = [];
    let headerFields = [];


    $('#report thead th').each(function (index, value) {
        if (index === 0) return; 

        let headerText = $(value).text().trim().replaceAll(',', ';');
        headerFields.push(headerText);
    });

    tableRows.push(headerFields);

    $('#report tbody tr').each(function () {
        let rowData = [];
        $(this).find("td").each(function (colIndex) {
            if (colIndex === 0) return; 

            let cellText = $(this).text().trim().replaceAll(',', ';');

            
            if (colIndex === 5 && !isNaN(cellText) && cellText.length > 5) {
                cellText = `'${cellText}`;  // Force Excel to treat it as text
            }

            rowData.push(cellText);
        });

        tableRows.push(rowData);
    });

    
    let wb = XLSX.utils.book_new();
    let ws = XLSX.utils.aoa_to_sheet(tableRows);
    XLSX.utils.book_append_sheet(wb, ws, "Report");

    let wbout = XLSX.write(wb, { bookType: "xlsx", type: "array" });
    let excelFile = new Blob([new Uint8Array(wbout)], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });

    
    let downloadLink = document.createElement("a");
    downloadLink.href = URL.createObjectURL(excelFile);
    downloadLink.download = "Report.xlsx";
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
}  
    
    
    
</script>

