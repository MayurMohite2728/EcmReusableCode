[// Initializing the Folder Browser Widget with default Parameters
<script>
    csui.onReady2([
                'csui/integration/folderbrowser/folderbrowser.widget'
            ], function (FolderBrowser) {
                [// To Add the Back Button Start
                var config = new csui.require.config({
          config: {
            "csui/integration/folderbrowser/commands/go.to.node.history": {
              enabled: true,
                }, 
            },
            });
            [// To Add the Back Button End
                var folderBrowser = new FolderBrowser({
                     connection: {
                         url: 'http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_URLPREFIX /]/api/v1', [// API Endpoint for initialization 
                         supportPath: 'http://eimsdemo.mannaicorp.com.qa[LL_REPTAG_SUPPORTDIR /]', [// Support Path Folder
                         session:{
                             ticket:'[LL_REPTAG_OTCSTICKET /]'  [// Logged in users ticket
                         }
                          },
                    start: {
                        id: [LL_REPTAG_&folderid /]  [// Folder ID to Load is send as a parameter
                    },
                    breadcrumb: false,   [// change to true if breadcrumd is required
                    showPageInfo:true,
                    config:config  [// To Add the Back Button
                });
                folderBrowser.show({
                    placeholder: '#content'  [//ID for the DIV to load this Widget
                })
            });
</script>
